// ==============================
// src/Dashboard.js
// ==============================
import { useEffect, useState } from "react";
import axios from "axios";
import {
  BarChart,
  Bar,
  XAxis,
  YAxis,
  Tooltip,
  CartesianGrid,
  ResponsiveContainer
} from "recharts";

const BACKEND_URL = "http://127.0.0.1:8000/dashboard";

export default function Dashboard() {
  const [data, setData] = useState([]);
  const [cost, setCost] = useState(0);
  const [insight, setInsight] = useState("");
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    axios
      .get(BACKEND_URL)
      .then((res) => {
        const formatted = Object.entries(res.data.optimization).map(
          ([route, value]) => ({
            route,
            shipments: value
          })
        );

        setData(formatted);
        setCost(res.data.total_cost);
        setInsight(res.data.ai_insight);
        setLoading(false);
      })
      .catch((err) => {
        console.error(err);
        setInsight("⚠️ Could not connect to backend.");
        setLoading(false);
      });
  }, []);

  if (loading) {
    return (
      <div style={styles.center}>
        <h2>Loading AI Supply Chain Dashboard...</h2>
      </div>
    );
  }

  return (
    <div style={styles.container}>
      <h1 style={styles.title}>AI Supply Chain Command Center</h1>

      <div style={styles.card}>
        <h2>Total Optimized Cost</h2>
        <p style={styles.cost}>${cost.toLocaleString()}</p>
      </div>

      <div style={styles.chartCard}>
        <h2>Optimized Shipments by Route</h2>

        <ResponsiveContainer width="100%" height={400}>
          <BarChart data={data}>
            <CartesianGrid strokeDasharray="3 3" />
            <XAxis dataKey="route" />
            <YAxis />
            <Tooltip />
            <Bar dataKey="shipments" />
          </BarChart>
        </ResponsiveContainer>
      </div>

      <div style={styles.aiCard}>
        <h2>Gemini Executive Insight</h2>
        <p style={{ lineHeight: 1.6 }}>{insight}</p>
      </div>
    </div>
  );
}


